{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Real",
  "version": "0.1.0",
  "identifier": "com.harmonization.git-real",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight desktop Git client",
    "longDescription": "Git Real is a lightweight, cross-platform desktop Git client: stage, commit, branch, merge, rebase, stash, tag, sync with remotes and work with pull requests and issues on GitHub, GitLab and Bitbucket.",
    "homepage": "https://github.com/harmonizationllc/git-real",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "vcs",
        "recommends": ["git"],
        "desktopTemplate": "packaging/git-real.desktop"
      },
      "rpm": {
        "desktopTemplate": "packaging/git-real.desktop"
      }
    }
  }
}
