[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} {{exec_arg}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
Keywords=git;vcs;version control;repository;commit;branch;
StartupNotify=true
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
